<?xml version="1.0" encoding="utf-8"?>
<!--
  Le5a Scorer type family — Inter, subset to Latin + a few symbols.
  Licensed under the SIL Open Font License 1.1 (see app/licenses/Inter-OFL.txt).

  Both the android: and app: namespaces are declared so the family resolves on
  API 26+ (framework) and API 24-25 (AppCompat compat loader).
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/inter_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/inter_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/inter_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/inter_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/inter_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/inter_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
