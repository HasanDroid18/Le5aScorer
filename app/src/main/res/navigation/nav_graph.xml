<?xml version="1.0" encoding="utf-8"?>
<!--
  The app opens on the game picker. Leekha and Tarneeb each own a match list,
  and both are served by the same MatchListFragment with a gameMode argument —
  the two lists differ only in which matches they show and what the toolbar
  says, so a second copy of the screen would be duplication with no payoff.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.hasanDroid.le5ascorer.ui.home.HomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_homeFragment_to_matchListFragment"
            app:destination="@id/matchListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/matchListFragment"
        android:name="com.hasanDroid.le5ascorer.ui.matches.MatchListFragment"
        android:label="@string/game_leekha">
        <!-- Which game's matches to show. A string rather than the enum so the
             argument stays readable in the graph and in back-stack dumps. -->
        <argument
            android:name="gameMode"
            app:argType="string"
            android:defaultValue="INDIVIDUAL" />
        <action
            android:id="@+id/action_matchListFragment_to_newMatchFragment"
            app:destination="@id/newMatchFragment" />
        <action
            android:id="@+id/action_matchListFragment_to_scoreboardFragment"
            app:destination="@id/scoreboardFragment" />
        <action
            android:id="@+id/action_matchListFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_matchListFragment_to_newTarneebMatchFragment"
            app:destination="@id/newTarneebMatchFragment" />
        <action
            android:id="@+id/action_matchListFragment_to_tarneebScoreboardFragment"
            app:destination="@id/tarneebScoreboardFragment" />
    </fragment>

    <!-- ==================== Leekha ==================== -->

    <fragment
        android:id="@+id/newMatchFragment"
        android:name="com.hasanDroid.le5ascorer.ui.newmatch.NewMatchFragment"
        android:label="@string/new_match">
        <action
            android:id="@+id/action_newMatchFragment_to_scoreboardFragment"
            app:destination="@id/scoreboardFragment"
            app:popUpTo="@id/matchListFragment" />
    </fragment>

    <fragment
        android:id="@+id/scoreboardFragment"
        android:name="com.hasanDroid.le5ascorer.ui.scoreboard.ScoreboardFragment"
        android:label="@string/scoreboard">
        <argument
            android:name="matchId"
            app:argType="long" />
        <action
            android:id="@+id/action_scoreboardFragment_to_roundEntryFragment"
            app:destination="@id/roundEntryFragment" />
        <!-- Pops back to the list rather than pushing a second copy of it, which
             is what this action used to do. -->
        <action
            android:id="@+id/action_scoreboardFragment_to_matchListFragment"
            app:destination="@id/matchListFragment"
            app:popUpTo="@id/matchListFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/roundEntryFragment"
        android:name="com.hasanDroid.le5ascorer.ui.round.RoundEntryFragment"
        android:label="@string/select_cards">
        <argument
            android:name="matchId"
            app:argType="long" />
        <argument
            android:name="roundId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="playerNames"
            app:argType="string[]" />
    </fragment>

    <!-- ==================== Tarneeb ==================== -->

    <fragment
        android:id="@+id/newTarneebMatchFragment"
        android:name="com.hasanDroid.le5ascorer.ui.tarneeb.NewTarneebMatchFragment"
        android:label="@string/new_match">
        <action
            android:id="@+id/action_newTarneebMatchFragment_to_tarneebScoreboardFragment"
            app:destination="@id/tarneebScoreboardFragment"
            app:popUpTo="@id/matchListFragment" />
    </fragment>

    <fragment
        android:id="@+id/tarneebScoreboardFragment"
        android:name="com.hasanDroid.le5ascorer.ui.tarneeb.TarneebScoreboardFragment"
        android:label="@string/scoreboard">
        <argument
            android:name="matchId"
            app:argType="long" />
        <action
            android:id="@+id/action_tarneebScoreboardFragment_to_tarneebRoundEntryFragment"
            app:destination="@id/tarneebRoundEntryFragment" />
        <action
            android:id="@+id/action_tarneebScoreboardFragment_to_matchListFragment"
            app:destination="@id/matchListFragment"
            app:popUpTo="@id/matchListFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/tarneebRoundEntryFragment"
        android:name="com.hasanDroid.le5ascorer.ui.tarneeb.TarneebRoundEntryFragment"
        android:label="@string/tarneeb_round_title">
        <argument
            android:name="matchId"
            app:argType="long" />
        <argument
            android:name="roundId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="teamNames"
            app:argType="string[]" />
    </fragment>

    <!-- ==================== Trix ==================== -->

    <fragment
        android:id="@+id/trixRoundEntryFragment"
        android:name="com.hasanDroid.le5ascorer.ui.trix.TrixRoundEntryFragment"
        android:label="@string/game_trix">
        <argument
            android:name="matchId"
            app:argType="long" />
        <!-- A TrixContractType name. -->
        <argument
            android:name="contractType"
            app:argType="string" />
        <argument
            android:name="playerNames"
            app:argType="string[]" />
        <argument
            android:name="doubling"
            app:argType="boolean" />
        <argument
            android:name="roundId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!-- ==================== Shared ==================== -->

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.hasanDroid.le5ascorer.ui.settings.SettingsFragment"
        android:label="@string/settings_title">
        <action
            android:id="@+id/action_settingsFragment_to_rulesFragment"
            app:destination="@id/rulesFragment" />
    </fragment>

    <fragment
        android:id="@+id/rulesFragment"
        android:name="com.hasanDroid.le5ascorer.ui.rules.RulesFragment"
        android:label="@string/rules_title" />

</navigation>
