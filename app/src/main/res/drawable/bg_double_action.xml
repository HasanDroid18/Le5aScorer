<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>
    <!-- Card layer with gradient -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/double_gradient_start"
                android:endColor="@color/double_gradient_end"
                android:type="linear" />
            <stroke android:width="2dp" android:color="@color/danger_red_800" />
        </shape>
    </item>
</layer-list>

