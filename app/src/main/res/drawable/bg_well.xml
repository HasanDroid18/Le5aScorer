<?xml version="1.0" encoding="utf-8"?>
<!-- A recessed area of the table where the cards are dealt. Reads as cut into
     the felt rather than floating above it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_lg" />
    <solid android:color="@color/overlay_well" />
    <stroke android:width="1dp" android:color="@color/felt_outline_soft" />
</shape>
