<?xml version="1.0" encoding="utf-8"?>
<!-- App bar: solid felt with a hairline brass edge along the bottom, so the
     bar separates from the table without a drop shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/felt_850" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/felt_outline" />
        </shape>
    </item>
</layer-list>
