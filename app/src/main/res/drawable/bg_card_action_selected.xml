<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/glow_blue" />
        </shape>
    </item>
    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>
    <!-- Card layer -->
    <item android:top="2dp" android:left="2dp" android:bottom="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card_ivory" />
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
</layer-list>

