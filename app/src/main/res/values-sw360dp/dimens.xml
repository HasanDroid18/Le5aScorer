<?xml version="1.0" encoding="utf-8"?>
<!--
  Anything at least 360dp wide — most phones. The base values in values/ are
  sized for the narrowest screens we support (320dp), where thirteen hearts plus
  their overlap would otherwise need to scroll sideways to be seen at all.

  Note the direction: smallest-width qualifiers match every screen *at least*
  that wide, so the base bucket has to hold the small-screen values and this one
  opts the roomier screens up. The reverse — a values-sw320dp holding small
  values — would match every modern phone and quietly override the base.
-->
<resources>
    <dimen name="heart_pip_width">28dp</dimen>
    <dimen name="heart_pip_height">40dp</dimen>
    <dimen name="heart_pip_overlap">-6dp</dimen>
    <dimen name="assign_card_width">60dp</dimen>
    <dimen name="assign_card_height">82dp</dimen>

    <!-- Room for a full-size round badge once the screen is not 320dp wide. -->
    <dimen name="tarneeb_round_col">44dp</dimen>
    <dimen name="tarneeb_score_col_min">48dp</dimen>

</resources>
