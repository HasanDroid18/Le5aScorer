<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/felt_green_800"
    app:strokeWidth="2dp"
    app:strokeColor="@color/chip_gold_dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textPlayers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonMenu"
            tools:text="Hasan, Mahdi, Ali, Hadi" />

        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-12dp"
            android:layout_marginTop="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/chip_gold"
            android:contentDescription="@string/settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textRuleSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#E0FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/textPlayers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Terminal: 101 • Individual" />

        <!-- Left Side: Rounds and Status -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/textRuleSummary"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/textRounds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#B0FFFFFF"
                android:drawableStart="@drawable/ic_cards"
                android:drawablePadding="4dp"
                android:drawableTint="@color/chip_gold"
                tools:text="5 Rounds" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:background="#40FFFFFF" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                tools:text="Completed" />

        </LinearLayout>

        <!-- Right Side: Leading Player Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLeadingPlayer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_ivory"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/chip_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textPlayers"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/loserImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/leading_player_avatar"
                tools:srcCompat="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="#80FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/layoutInfo"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Nov 30, 2025 15:30" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/textDate"
            app:layout_constraintTop_toBottomOf="@+id/layoutInfo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="Leading"
                android:textAllCaps="true"
                android:textColor="#80000000"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLeaderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:layout_marginStart="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Ahmad" />

            <TextView
                android:id="@+id/textLeaderScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chip_gold_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                tools:text="45" />


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

