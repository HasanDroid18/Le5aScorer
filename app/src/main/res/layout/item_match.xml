<?xml version="1.0" encoding="utf-8"?>
<!--
  A match card.

  It shows the whole table rather than one leader: four standings rows, each
  with a bar showing how close that player is to the target. Since reaching the
  target is how you *lose*, the longest bar is the player in most trouble — the
  card reads as a race nobody wants to win.

  The leading player's photo, when one was taken, sits on the right.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Le5a.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin"
    android:layout_marginVertical="@dimen/space_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Status-keyed edge: brass while in progress, green once complete. -->
        <View
            android:id="@+id/accentEdge"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_status_accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textRuleSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.Le5a.Overline"
            app:layout_constraintEnd_toStartOf="@id/cardLeadingPlayer"
            app:layout_constraintStart_toEndOf="@id/accentEdge"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Target 101" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenu"
            style="@style/Widget.Le5a.Button.Icon"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_match_options"
            app:icon="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Photo of whoever is closest to losing. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLeadingPlayer"
            android:layout_width="@dimen/match_avatar"
            android:layout_height="@dimen/match_avatar"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_md"
            app:cardBackgroundColor="@color/felt_700"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="@dimen/elev_flat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonMenu"
            app:strokeColor="@color/brass_600"
            app:strokeWidth="@dimen/stroke_hairline">

            <ImageView
                android:id="@+id/loserImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_leading_player_photo"
                android:padding="@dimen/space_lg"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_person"
                app:tint="@color/text_tertiary"
                tools:srcCompat="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== Standings ==================== -->
        <LinearLayout
            android:id="@+id/layoutStandings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_md"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/cardLeadingPlayer"
            app:layout_constraintStart_toEndOf="@id/accentEdge"
            app:layout_constraintTop_toBottomOf="@id/textRuleSummary">

            <include
                android:id="@+id/standing1"
                layout="@layout/view_standing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/standing2"
                layout="@layout/view_standing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/standing3"
                layout="@layout/view_standing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/standing4"
                layout="@layout/view_standing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Shown instead of the standings before the first round is entered. -->
        <TextView
            android:id="@+id/textPlayers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/cardLeadingPlayer"
            app:layout_constraintStart_toEndOf="@id/accentEdge"
            app:layout_constraintTop_toBottomOf="@id/textRuleSummary"
            tools:text="Ahmad, Sara, Khaled, Fatima"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="layoutStandings,textPlayers,cardLeadingPlayer" />

        <!-- ==================== Footer ==================== -->
        <TextView
            android:id="@+id/textRounds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
            app:drawableStartCompat="@drawable/ic_card_stack"
            app:drawableTint="@color/text_tertiary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/accentEdge"
            app:layout_constraintTop_toBottomOf="@id/barrierBody"
            tools:text="5 rounds" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
            android:textColor="@color/text_tertiary"
            app:layout_constraintBottom_toBottomOf="@id/textRounds"
            app:layout_constraintEnd_toStartOf="@id/textStatus"
            app:layout_constraintStart_toEndOf="@id/textRounds"
            app:layout_constraintTop_toTopOf="@id/textRounds"
            tools:text="Nov 30, 2025 15:30" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/bg_pill_neutral"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Le5a.Overline"
            app:layout_constraintBottom_toBottomOf="@id/textRounds"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textRounds"
            tools:text="In Progress" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
