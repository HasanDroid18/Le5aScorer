<?xml version="1.0" encoding="utf-8"?>
<!--
  Round entry, portrait.

  The four players sit around a table rather than in a 2x2 grid of tiles. Seats
  are positioned with ConstraintLayout circular positioning (layout_constraintCircle
  + CircleAngle + CircleRadius) at 0/90/180/270 degrees around a centre anchor,
  so the arrangement reads as a table and adapts by changing one radius dimen
  instead of by rewriting constraints.

  Dealing is order-free: tap a card then a seat, or a seat then a card. Whichever
  comes first arms; the second completes. It stays pure tap, so there is no
  drag-only affordance and nothing is unreachable with a screen reader.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_table">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_bar"
        android:elevation="@dimen/elev_flat"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/select_cards">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReset"
                style="@style/Widget.Le5a.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/space_xs"
                android:text="@string/reset"
                app:icon="@drawable/ic_undo" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md">

            <include
                android:id="@+id/roundStatus"
                layout="@layout/view_round_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ==================== The table ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tableArea"
                android:layout_width="match_parent"
                android:layout_height="@dimen/table_size"
                android:layout_marginTop="@dimen/space_lg">

                <View
                    android:id="@+id/tableSurface"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_table"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.72"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Anchor the seats orbit. Zero-sized and invisible; it exists
                     only to give the circular constraints something to sit on. -->
                <View
                    android:id="@+id/tableCentre"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/tableSurface"
                    app:layout_constraintEnd_toEndOf="@id/tableSurface"
                    app:layout_constraintStart_toStartOf="@id/tableSurface"
                    app:layout_constraintTop_toTopOf="@id/tableSurface" />

                <!-- What is armed and waiting to be dealt, or the prompt. -->
                <LinearLayout
                    android:id="@+id/layoutArmed"
                    android:layout_width="@dimen/table_centre"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/tableSurface"
                    app:layout_constraintEnd_toEndOf="@id/tableSurface"
                    app:layout_constraintStart_toStartOf="@id/tableSurface"
                    app:layout_constraintTop_toTopOf="@id/tableSurface">

                    <TextView
                        android:id="@+id/textArmedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/round_armed"
                        android:textAppearance="@style/TextAppearance.Le5a.Overline"
                        android:visibility="invisible"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/imageArmed"
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginTop="@dimen/space_xs"
                        android:contentDescription="@null"
                        android:visibility="invisible"
                        app:srcCompat="@drawable/ic_suit_heart"
                        app:tint="@color/brass_400"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textTapHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/round_tap_hint"
                        android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                        android:textColor="@color/text_tertiary" />

                </LinearLayout>

                <!-- Seats, clockwise from the top. -->
                <include
                    android:id="@+id/seat1"
                    layout="@layout/view_player_seat"
                    android:layout_width="@dimen/seat_width"
                    android:layout_height="wrap_content"
                    app:layout_constraintCircle="@id/tableCentre"
                    app:layout_constraintCircleAngle="0"
                    app:layout_constraintCircleRadius="@dimen/table_radius" />

                <include
                    android:id="@+id/seat2"
                    layout="@layout/view_player_seat"
                    android:layout_width="@dimen/seat_width"
                    android:layout_height="wrap_content"
                    app:layout_constraintCircle="@id/tableCentre"
                    app:layout_constraintCircleAngle="90"
                    app:layout_constraintCircleRadius="@dimen/table_radius" />

                <include
                    android:id="@+id/seat3"
                    layout="@layout/view_player_seat"
                    android:layout_width="@dimen/seat_width"
                    android:layout_height="wrap_content"
                    app:layout_constraintCircle="@id/tableCentre"
                    app:layout_constraintCircleAngle="180"
                    app:layout_constraintCircleRadius="@dimen/table_radius" />

                <include
                    android:id="@+id/seat4"
                    layout="@layout/view_player_seat"
                    android:layout_width="@dimen/seat_width"
                    android:layout_height="wrap_content"
                    app:layout_constraintCircle="@id/tableCentre"
                    app:layout_constraintCircleAngle="270"
                    app:layout_constraintCircleRadius="@dimen/table_radius" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ==================== Card rail ==================== -->
            <include
                android:id="@+id/cardRail"
                layout="@layout/view_card_rail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <TextView
                android:id="@+id/textHeartsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_sm"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/hearts_hint"
                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                android:textColor="@color/text_tertiary"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/text_tertiary" />

            <!-- ==================== Taken this round ==================== -->
            <TextView
                android:id="@+id/labelSelectedActions"
                style="@style/Widget.Le5a.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/selected_actions" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_xs" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSave"
        style="@style/Widget.Le5a.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:enabled="false"
        android:text="@string/save_round"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
