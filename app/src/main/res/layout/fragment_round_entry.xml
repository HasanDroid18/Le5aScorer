<?xml version="1.0" encoding="utf-8"?>
<!--
  Round entry.

  Three questions have to be answerable at a glance: how far along is the round,
  who am I scoring for, and what is still missing before I can save. The status
  card answers the first and third (running total plus an explicit checklist),
  and the "Scoring for" line above the play area answers the second.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_table">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_bar"
        android:elevation="@dimen/elev_flat"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/select_cards">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReset"
                style="@style/Widget.Le5a.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/space_xs"
                android:text="@string/reset"
                app:icon="@drawable/ic_undo"
                app:iconSize="@dimen/icon_sm" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md">

            <!-- ==================== Status ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                style="@style/Widget.Le5a.Card.Raised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/round_status"
                                android:textAppearance="@style/TextAppearance.Le5a.Overline" />

                            <TextView
                                android:id="@+id/textRoundTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textAppearance="@style/TextAppearance.Le5a.Score.Display"
                                tools:text="24 / 36" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressRound"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:max="36"
                            android:progress="0"
                            app:indicatorSize="64dp" />

                    </LinearLayout>

                    <!-- Checklist: what still has to be true to save. -->
                    <LinearLayout
                        android:id="@+id/layoutNormalStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/space_md"
                            android:background="@color/felt_outline" />

                        <TextView
                            style="@style/Widget.Le5a.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/round_checklist_title" />

                        <include
                            android:id="@+id/checkHearts"
                            layout="@layout/view_check_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <include
                            android:id="@+id/checkQueen"
                            layout="@layout/view_check_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/checkTen"
                            layout="@layout/view_check_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Double: one player takes everything, so the checklist
                         does not apply. -->
                    <LinearLayout
                        android:id="@+id/layoutDoubleStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_pill_danger"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/double_active"
                            android:textAppearance="@style/TextAppearance.Le5a.Overline"
                            android:textColor="@color/danger" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/double_subtitle"
                            android:textAppearance="@style/TextAppearance.Le5a.Body.Small" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Players ==================== -->
            <TextView
                android:id="@+id/textScoringForLabel"
                style="@style/Widget.Le5a.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/round_scoring_for" />

            <TextView
                android:id="@+id/textScoringFor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Le5a.Title"
                android:textColor="@color/brass_300"
                tools:text="Ahmad" />

            <GridLayout
                android:id="@+id/layoutPlayerRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:columnOrderPreserved="false"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <include
                    android:id="@+id/rowPlayer1"
                    layout="@layout/item_player_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:layout_row="0" />

                <include
                    android:id="@+id/rowPlayer2"
                    layout="@layout/item_player_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:layout_row="0" />

                <include
                    android:id="@+id/rowPlayer3"
                    layout="@layout/item_player_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:layout_row="1" />

                <include
                    android:id="@+id/rowPlayer4"
                    layout="@layout/item_player_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:layout_row="1" />

            </GridLayout>

            <!-- ==================== Play area ====================
                 A recess cut into the felt where the four cards lie. -->
            <FrameLayout
                android:id="@+id/containerPlayArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_well"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHearts"
                        style="@style/Widget.Le5a.Card.Playing.Clickable"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/action_card_height"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_sm">

                            <ImageView
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_suit_heart"
                                app:tint="@color/ink_red" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/hearts_card"
                                android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hearts_value"
                                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                                android:textColor="@color/ink_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardQSpades"
                        style="@style/Widget.Le5a.Card.Playing.Clickable"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/action_card_height"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_sm">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_queen"
                                    android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
                                    android:textColor="@color/ink" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:layout_marginStart="2dp"
                                    android:contentDescription="@null"
                                    app:srcCompat="@drawable/ic_suit_spade"
                                    app:tint="@color/ink" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/q_spades_card"
                                android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/q_spades_value"
                                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                                android:textColor="@color/ink_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTenDiamonds"
                        style="@style/Widget.Le5a.Card.Playing.Clickable"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/action_card_height"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_sm">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_ten"
                                    android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
                                    android:textColor="@color/ink_red" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:layout_marginStart="2dp"
                                    android:contentDescription="@null"
                                    app:srcCompat="@drawable/ic_suit_diamond"
                                    app:tint="@color/ink_red" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/ten_diamonds_card"
                                android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
                                android:textColor="@color/ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ten_diamonds_value"
                                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                                android:textColor="@color/ink_muted" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- The Double is not a card you take; it is a whole-round
                         outcome, so it is styled as a face-down red back. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDouble"
                        style="@style/Widget.Le5a.Card.Playing.Clickable"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/action_card_height"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/danger_strong"
                        app:strokeColor="@color/danger"
                        app:strokeWidth="@dimen/stroke_hairline">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/double_value"
                                android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/double_card"
                                android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </FrameLayout>

            <!-- Makes the +5 shortcut discoverable. The string for this gesture
                 already existed but was never shown anywhere. -->
            <TextView
                android:id="@+id/textHeartsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_sm"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/hearts_hint"
                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                android:textColor="@color/text_tertiary"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/text_tertiary" />

            <!-- ==================== Taken this round ==================== -->
            <TextView
                android:id="@+id/labelSelectedActions"
                style="@style/Widget.Le5a.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/selected_actions" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_xs" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSave"
        style="@style/Widget.Le5a.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:enabled="false"
        android:text="@string/save_round"
        app:cornerRadius="@dimen/radius_pill"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
