<?xml version="1.0" encoding="utf-8"?>
<!--
  Round entry.

  Structure follows the reference design: the thirteen hearts fanned across the
  top as a pool that empties as they are dealt, the Q♠ and 10♦ beneath it
  showing who holds them, then one row per player carrying that player's four
  buttons — hearts, Q♠, 10♦ and the Double.

  Rendered on the felt palette so it sits with the rest of the app; the cards
  themselves stay bone-white, because they are cards.

  There is no "select a player first" step any more: every button belongs to the
  player whose row it is in, so what you tap is what happens. That also removes
  the need for a separate validity checklist — the pool shows the hearts still
  to deal and the two cards show whether the Q and 10 are placed.

  One vertical scroll, so it works in landscape without a separate layout.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_table">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_bar"
        android:elevation="@dimen/elev_flat"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/select_cards">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReset"
                style="@style/Widget.Le5a.Button.Icon"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/reset"
                app:icon="@drawable/ic_undo"
                app:iconTint="@color/text_primary" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_lg">

            <!-- ============ The thirteen hearts, fanned ============ -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutHeartPool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_xs" />

            </HorizontalScrollView>

            <TextView
                android:id="@+id/textHeartsRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
                tools:text="Hearts 6 / 13" />

            <!-- ============ Q♠ and 10♦, and who holds them ============ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Le5a.Card.Playing"
                        android:layout_width="@dimen/assign_card_width"
                        android:layout_height="@dimen/assign_card_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_queen"
                                android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
                                android:textColor="@color/ink" />

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:contentDescription="@string/cd_queen_spades"
                                app:srcCompat="@drawable/ic_suit_spade"
                                app:tint="@color/ink" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textQueenHolder"
                        android:layout_width="@dimen/assign_card_width"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/unassigned"
                        android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                        tools:text="Ahmad" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Le5a.Card.Playing"
                        android:layout_width="@dimen/assign_card_width"
                        android:layout_height="@dimen/assign_card_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_ten"
                                android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
                                android:textColor="@color/ink_red" />

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:contentDescription="@string/cd_ten_diamonds"
                                app:srcCompat="@drawable/ic_suit_diamond"
                                app:tint="@color/ink_red" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textTenHolder"
                        android:layout_width="@dimen/assign_card_width"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/unassigned"
                        android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                        tools:text="Sara" />

                </LinearLayout>

            </LinearLayout>

            <!-- Double takes the whole round, so it replaces the pool state. -->
            <TextView
                android:id="@+id/textDoubleNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_pill_danger"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="@string/double_subtitle"
                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_fade" />

            <!-- ==================== Player rows ==================== -->
            <include
                android:id="@+id/rowPlayer1"
                layout="@layout/view_player_scoring_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowPlayer2"
                layout="@layout/view_player_scoring_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowPlayer3"
                layout="@layout/view_player_scoring_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowPlayer4"
                layout="@layout/view_player_scoring_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/textHeartsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/hearts_hint"
                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                android:textColor="@color/text_tertiary" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/textRoundTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Le5a.Label.Small"
        app:layout_constraintBottom_toTopOf="@id/buttonSave"
        app:layout_constraintEnd_toEndOf="@id/buttonSave"
        app:layout_constraintStart_toStartOf="@id/buttonSave"
        tools:text="24 / 36" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSave"
        style="@style/Widget.Le5a.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:enabled="false"
        android:text="@string/save_round"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
