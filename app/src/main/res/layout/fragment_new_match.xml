<?xml version="1.0" encoding="utf-8"?>
<!--
  New match setup.

  The four player fields previously repeated ~20 attributes each; they now carry
  a single style reference. Section headers are icon + overline rather than
  emoji + gold bold title.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_table">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_bar"
        android:elevation="@dimen/elev_flat">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/new_match" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/sticky_button_clearance"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_lg">

            <!-- ==================== Players ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlayers"
                style="@style/Widget.Le5a.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_people"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            style="@style/Widget.Le5a.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/first_team" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Le5a.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/player_1"
                        app:endIconMode="clear_text"
                        app:placeholderText="@string/player_hint_1"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPlayer1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            tools:text="Ahmad" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Le5a.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/player_2"
                        app:endIconMode="clear_text"
                        app:placeholderText="@string/player_hint_2"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPlayer2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            tools:text="Sara" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ==================== VS ==================== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/space_lg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/divider_fade" />

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="@dimen/space_md"
                            android:background="@drawable/bg_vs_badge"
                            android:gravity="center"
                            android:text="@string/vs_label"
                            android:textAppearance="@style/TextAppearance.Le5a.Overline"
                            android:textColor="@color/brass_300" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/divider_fade" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_people"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            style="@style/Widget.Le5a.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/second_team" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Le5a.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/player_3"
                        app:endIconMode="clear_text"
                        app:placeholderText="@string/player_hint_3"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPlayer3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            tools:text="Khaled" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Le5a.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/player_4"
                        app:endIconMode="clear_text"
                        app:placeholderText="@string/player_hint_4"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPlayer4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            tools:text="Fatima" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Rules ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRules"
                style="@style/Widget.Le5a.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_target"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            style="@style/Widget.Le5a.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/terminal_score_label" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTerminalScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        app:checkedButton="@id/button101"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/button51"
                            style="@style/Widget.Le5a.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_terminal_51"
                            android:text="@string/terminal_51" />

                        <Button
                            android:id="@+id/button101"
                            style="@style/Widget.Le5a.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_terminal_101"
                            android:text="@string/terminal_101" />

                        <Button
                            android:id="@+id/button151"
                            style="@style/Widget.Le5a.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_terminal_151"
                            android:text="@string/terminal_151" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_lg"
                        android:background="@drawable/divider_fade" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_scale"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            style="@style/Widget.Le5a.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/score_rule" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleScoreRule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        app:checkedButton="@id/buttonIndividual"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/buttonIndividual"
                            style="@style/Widget.Le5a.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_individual_rule"
                            android:text="@string/rule_individual"
                            app:icon="@drawable/ic_person"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_xs"
                            app:iconSize="@dimen/icon_sm" />

                        <Button
                            android:id="@+id/buttonTeam"
                            style="@style/Widget.Le5a.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_team_rule"
                            android:text="@string/rule_team"
                            app:icon="@drawable/ic_people"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_xs"
                            app:iconSize="@dimen/icon_sm" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_info_note"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_info"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/textRuleDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="@string/rule_individual_desc"
                            android:textAppearance="@style/TextAppearance.Le5a.Body.Small" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fade so content dissolves under the sticky button instead of being cut. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sticky_button_clearance"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_fade"
        android:translationZ="@dimen/elev_raised" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCreate"
        style="@style/Widget.Le5a.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:contentDescription="@string/cd_create_match"
        android:enabled="false"
        android:text="@string/create_match"
        app:cornerRadius="@dimen/radius_pill"
        app:elevation="@dimen/elev_float"
        app:icon="@drawable/ic_card_stack"
        app:iconGravity="textStart" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
