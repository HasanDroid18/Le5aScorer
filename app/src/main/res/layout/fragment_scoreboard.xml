<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoreboard.

  The header and every row are built from the same three column dimensions
  (scoreboard_round_col / scoreboard_gutter / scoreboard_action_col) with equal
  card margins and padding, so the player columns line up structurally. They
  previously matched only because two independently chosen sets of numbers
  happened to add up the same.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_table">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_bar"
        android:elevation="@dimen/elev_flat"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/scoreboard" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Result banner. This announces who *lost*, so it is styled as an error
         state — it used to be a green "success" card carrying the loser's name. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWinner"
        style="@style/Widget.Le5a.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_md"
        android:visibility="gone"
        app:cardBackgroundColor="@color/danger_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:strokeColor="@color/danger"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_trophy"
                app:tint="@color/danger" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_over_title"
                    android:textAppearance="@style/TextAppearance.Le5a.Overline"
                    android:textColor="@color/danger" />

                <TextView
                    android:id="@+id/textWinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Le5a.Title"
                    tools:text="Ahmad reached the target" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== Standings header ====================
         Was a bare strip of four names. It now carries the live standings —
         each player's running total and how far it has travelled toward the
         target — so the answer to "who's losing" is on screen without reading
         down to the last row. The columns keep the row layout's exact
         proportions, so they still line up with the per-round cells beneath. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlayerNames"
        style="@style/Widget.Le5a.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_md"
        app:cardBackgroundColor="@color/felt_850"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardWinner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textTargetLabel"
                    android:layout_width="@dimen/scoreboard_round_col"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Le5a.Overline"
                    tools:text="/101" />

                <LinearLayout
                    android:id="@+id/layoutPlayerNamesHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/scoreboard_gutter"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- An <include> that overrides any layout param must declare
                         width and height too, or inflation throws. -->
                    <include
                        android:id="@+id/column1"
                        layout="@layout/view_standing_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/column2"
                        layout="@layout/view_standing_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/column3"
                        layout="@layout/view_standing_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/column4"
                        layout="@layout/view_standing_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                </LinearLayout>

                <!-- Mirrors the edit button's column on each row. -->
                <View
                    android:layout_width="@dimen/scoreboard_action_col"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/scoreboard_gutter" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@color/felt_outline" />

            <!-- Legend for the rows below, which now carry two figures per
                 player rather than one. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/scoreboard_round_col"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/scoreboard_round_column"
                    android:textAppearance="@style/TextAppearance.Le5a.Overline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/scoreboard_gutter"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/scoreboard_cell_legend"
                    android:textAppearance="@style/TextAppearance.Le5a.Overline" />

                <View
                    android:layout_width="@dimen/scoreboard_action_col"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/scoreboard_gutter" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPlayerNames">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_scoreboard_row" />

            <include
                android:id="@+id/emptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_2xl"
                android:indeterminateTint="@color/brass_400"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddRound"
            style="@style/Widget.Le5a.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_round"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBackToHome"
            style="@style/Widget.Le5a.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_matches"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart" />

    </LinearLayout>

    <include
        android:id="@+id/confettiOverlay"
        layout="@layout/view_fullscreen_confetti"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
