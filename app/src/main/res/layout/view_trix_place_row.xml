<?xml version="1.0" encoding="utf-8"?>
<!--
  One player's finishing place in the Trix contract. The places sit on their own
  line under the name so four buttons fit a 320dp screen. No id on the root —
  included four times.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Le5a.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPlaceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Le5a.Title"
                tools:text="Hasan" />

            <TextView
                android:id="@+id/textPlacePoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Le5a.Score.Medium"
                tools:text="+50" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/togglePlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/buttonPlace1"
                style="@style/Widget.Le5a.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trix_place_1" />

            <Button
                android:id="@+id/buttonPlace2"
                style="@style/Widget.Le5a.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trix_place_2" />

            <Button
                android:id="@+id/buttonPlace3"
                style="@style/Widget.Le5a.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trix_place_3" />

            <Button
                android:id="@+id/buttonPlace4"
                style="@style/Widget.Le5a.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trix_place_4" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
