<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/transparent">

    <!-- Semi-transparent scrim handled by the dialog window background in the theme overlay -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/card_ivory">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Confetti animation is shown full-screen (outside this card) -->

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/end_game_title"
                android:textColor="@color/suit_black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLoserLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/end_game_loser_label"
                android:textColor="@color/status_invalid_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textLoser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/not_assigned"
                android:textColor="@color/danger_red_800"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/suit_black"
                android:textSize="15sp"
                android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonShowRoundScores"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="@string/end_game_show_round_scores"
                android:textStyle="bold"
                android:backgroundTint="@color/felt_green_900"
                android:textColor="@color/white"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
