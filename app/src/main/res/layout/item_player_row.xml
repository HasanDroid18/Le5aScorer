<?xml version="1.0" encoding="utf-8"?>
<!--
  One of the four player tiles on the round-entry screen.

  Tapping a tile chooses who the next card goes to, so selection has to be
  unmistakable: the selected tile fills with brass and flips to ink text
  (applied in RoundEntryFragment, which also sets the stroke and elevation from
  dimen resources rather than raw pixel values).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlayerRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_min"
    app:cardBackgroundColor="@color/felt_700"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elev_raised"
    app:rippleColor="@color/overlay_ripple_brass"
    app:strokeColor="@color/felt_outline"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/textPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Le5a.Title.Small"
            tools:text="Ahmad" />

        <TextView
            android:id="@+id/textPlayerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Le5a.Score.Large"
            tools:text="13" />

        <!-- What this player has taken so far this round. -->
        <LinearLayout
            android:id="@+id/layoutCardIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutHearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iconHearts"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/cd_hearts"
                    app:srcCompat="@drawable/ic_suit_heart"
                    app:tint="@color/ink_red" />

                <TextView
                    android:id="@+id/textHeartCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textAppearance="@style/TextAppearance.Le5a.Score.Small"
                    android:textColor="@color/ink_red"
                    tools:text="×5" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutQSpades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textQSpadesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_queen"
                    android:textAppearance="@style/TextAppearance.Le5a.Score.Small" />

                <ImageView
                    android:id="@+id/iconQSpades"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@string/cd_queen_spades"
                    app:srcCompat="@drawable/ic_suit_spade" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTenDiamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textTenLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ten"
                    android:textAppearance="@style/TextAppearance.Le5a.Score.Small"
                    android:textColor="@color/ink_red" />

                <ImageView
                    android:id="@+id/iconTenDiamonds"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@string/cd_ten_diamonds"
                    app:srcCompat="@drawable/ic_suit_diamond"
                    app:tint="@color/ink_red" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
