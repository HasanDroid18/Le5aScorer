<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlayerRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:rippleColor="@color/glow_gold">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Name and Score stacked -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/textPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player 1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/suit_black"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Ahmad" />

            <TextView
                android:id="@+id/textPlayerScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/suit_red"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                tools:text="13" />

        </LinearLayout>

        <!-- Right Column: Card Indicators in stair pattern -->
        <LinearLayout
            android:id="@+id/layoutCardIcons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <!-- First row: 1 card indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">

                <LinearLayout
                    android:id="@+id/layoutHearts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#10FF0000"
                    android:gravity="right"
                    android:padding="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/iconHearts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♥"
                        android:textSize="12sp"
                        android:textColor="@color/suit_red"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/textHeartCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="×5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/suit_red" />

                </LinearLayout>

            </LinearLayout>

            <!-- Second row: 2 card indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconQSpades"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Q♠"
                    android:textSize="12sp"
                    android:textColor="@color/suit_black"
                    android:visibility="gone"
                    android:background="#10000000"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/iconTenDiamonds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10♦"
                    android:textSize="12sp"
                    android:textColor="@color/suit_red"
                    android:visibility="gone"
                    android:background="#10FF0000"
                    android:padding="6dp"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

