<?xml version="1.0" encoding="utf-8"?>
<!--
  One queen in Trix contract entry: which team took it, and whether it was
  doubled. No id on the root — included four times, and <include> replaces an
  included root's own id with the include's.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Le5a.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textQueenSuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_min"
                android:textAppearance="@style/TextAppearance.Le5a.Title"
                tools:text="Q♠" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleQueenTeam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/buttonQueenTeamA"
                    style="@style/Widget.Le5a.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Hasan &amp; Hsen" />

                <Button
                    android:id="@+id/buttonQueenTeamB"
                    style="@style/Widget.Le5a.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Ali &amp; Meso" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutQueenDoubled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trix_doubled"
                android:textAppearance="@style/TextAppearance.Le5a.Overline" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleQueenDoubled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@id/buttonQueenDoubledNo"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/buttonQueenDoubledNo"
                    style="@style/Widget.Le5a.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trix_no" />

                <Button
                    android:id="@+id/buttonQueenDoubledYes"
                    style="@style/Widget.Le5a.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trix_yes" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
