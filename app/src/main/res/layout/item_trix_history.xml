<?xml version="1.0" encoding="utf-8"?>
<!-- One played contract: what it was, whose kingdom, and what each team got. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Le5a.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textHistoryContract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Le5a.Label"
                tools:text="King of Hearts" />

            <TextView
                android:id="@+id/textHistoryOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Le5a.Body.Small"
                android:textColor="@color/text_secondary"
                tools:text="Ali's kingdom" />

        </LinearLayout>

        <TextView
            android:id="@+id/textHistoryPointsA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="@dimen/tarneeb_stepper_value"
            android:textAppearance="@style/TextAppearance.Le5a.Score.Medium"
            tools:text="−150" />

        <TextView
            android:id="@+id/textHistoryPointsB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:gravity="end"
            android:minWidth="@dimen/tarneeb_stepper_value"
            android:textAppearance="@style/TextAppearance.Le5a.Score.Medium"
            tools:text="+75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEdit"
            style="@style/Widget.Le5a.Button.Icon"
            android:layout_width="@dimen/scoreboard_action_col"
            android:layout_height="@dimen/scoreboard_action_col"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/edit_round"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
