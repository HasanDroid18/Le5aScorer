<?xml version="1.0" encoding="utf-8"?>
<!--
  One round of the scoreboard, laid out as a printed score-pad line.

  Column widths, gutters and padding must stay identical to the header block in
  fragment_scoreboard.xml — both read the same dimen resources.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Le5a.Card.Playing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin"
    android:layout_marginVertical="@dimen/space_xs"
    app:cardElevation="@dimen/elev_raised">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/textRound"
            android:layout_width="@dimen/scoreboard_round_col"
            android:layout_height="@dimen/scoreboard_round_col"
            android:background="@drawable/bg_round_badge"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Le5a.Score.Medium"
            android:textColor="@color/ink"
            tools:text="1" />

        <LinearLayout
            android:id="@+id/layoutScoreColumns"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/scoreboard_gutter"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Each include must restate layout_width/height/weight: an <include>
                 that overrides any layout param has to declare width and height
                 too, or inflation throws. -->
            <include
                android:id="@+id/cell1"
                layout="@layout/view_score_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/cell2"
                layout="@layout/view_score_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/cell3"
                layout="@layout/view_score_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/cell4"
                layout="@layout/view_score_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEdit"
            style="@style/Widget.Le5a.Button.Icon"
            android:layout_width="@dimen/scoreboard_action_col"
            android:layout_height="@dimen/scoreboard_action_col"
            android:layout_marginStart="@dimen/scoreboard_gutter"
            android:contentDescription="@string/edit_round"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/ink_muted"
            app:rippleColor="@color/bone_shade" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
