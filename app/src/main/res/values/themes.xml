<resources>
    <!-- Base application theme - Card Table / Solitaire Design -->
    <style name="Base.Theme.Le5aScorer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - Gold chip accents -->
        <item name="colorPrimary">@color/chip_gold</item>
        <item name="colorPrimaryVariant">@color/chip_gold_dark</item>
        <item name="colorOnPrimary">@color/felt_green_900</item>

        <!-- Secondary colors - Felt green -->
        <item name="colorSecondary">@color/felt_green_700</item>
        <item name="colorSecondaryVariant">@color/felt_green_800</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background colors - Felt table -->
        <!-- first one for default splash screen-->
        <item name="android:colorBackground">@color/felt_green_800</item>
        <item name="colorSurface">@color/card_ivory</item>
        <item name="colorSurfaceVariant">@color/felt_green_700</item>
        <item name="colorOnSurface">@color/suit_black</item>
        <item name="colorOnSurfaceVariant">@color/white</item>

        <!-- Status bar - Dark felt (match top bars) -->
        <item name="android:statusBarColor">@color/felt_green_900</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Ensure status bar icons/text are white -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Notch / display cutout support is provided via values-v27/ themes.xml -->

        <!-- Material 3 shape system - rounded corners for card-like feel -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Le5aScorer.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Le5aScorer.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Le5aScorer.LargeComponent</item>

        <!-- Typography - Clean, readable for cards -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Le5aScorer.HeadlineLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Le5aScorer.BodyLarge</item>
    </style>

    <style name="Theme.Le5aScorer" parent="Base.Theme.Le5aScorer" />

    <!-- Shape Appearances - Card-like rounded corners -->
    <style name="ShapeAppearance.Le5aScorer.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Le5aScorer.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Le5aScorer.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Le5aScorer.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Le5aScorer.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.Le5aScorer.Splash" parent="Theme.Le5aScorer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@drawable/bg_felt_table</item>

        <!-- Edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- End-game dialog theme overlay (NO dim scrim; confetti should stay bright) -->
    <style name="ThemeOverlay.Le5aScorer.EndGameDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:backgroundDimAmount">0.0</item>

        <!-- Remove Material dialog's default surface/insets that can show as a white container -->
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="alertDialogStyle">@style/Widget.Le5aScorer.TransparentAlertDialog</item>
    </style>

    <style name="Widget.Le5aScorer.TransparentAlertDialog" parent="@style/ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>