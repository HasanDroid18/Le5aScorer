<?xml version="1.0" encoding="utf-8"?>
<!--
  Type scale — Inter, bundled at three weights (see res/font/le5a_sans.xml).

  Weights are pinned to concrete font files rather than relying on
  fontFamily + textStyle, so API 24-25 never falls back to synthetic bold.

  The Score.* appearances carry fontFeatureSettings="tnum" (tabular figures).
  That is what makes the scoreboard's per-player columns line up: with the
  default proportional figures a "1" is narrower than a "8", so numbers of the
  same digit count still rendered at different widths.
-->
<resources>

    <!-- ============================ Display ============================ -->
    <style name="TextAppearance.Le5a.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ============================ Headline =========================== -->
    <style name="TextAppearance.Le5a.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ============================= Title ============================= -->
    <style name="TextAppearance.Le5a.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Le5a.Title.Small">
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ============================== Body ============================= -->
    <style name="TextAppearance.Le5a.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Le5a.Body.Small">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ============================== Label ============================ -->
    <!-- Used for buttons, tabs and inline metadata. -->
    <style name="TextAppearance.Le5a.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Le5a.Label.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Section headers: small, tracked-out, quiet. Replaces the previous
         emoji + gold bold title pattern. -->
    <style name="TextAppearance.Le5a.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ============================== Score ============================
         Numerals. tnum gives every digit the same advance width. -->
    <style name="TextAppearance.Le5a.Score" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Le5a.Score.Display">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.Le5a.Score.Large">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Le5a.Score.Medium">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Le5a.Score.Small">
        <item name="android:textSize">14sp</item>
    </style>

</resources>
