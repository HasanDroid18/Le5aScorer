<?xml version="1.0" encoding="utf-8"?>
<!--
  Le5a Scorer palette.

  The app is a card table: a deep, desaturated felt surface with brass accents and
  bone-white playing cards laid on it. Every colour used anywhere in the app is
  named here — layouts must never inline a hex value, so the whole app can be
  retinted from this one file.

  Ramps are ordered light -> dark within each family, matching the Material
  convention (higher number = darker for felt, = darker for brass).
-->
<resources>

    <!-- ===================================================================
         Felt — the table surface. Desaturated so brass can sit on it without
         vibrating, and dark enough that bone cards read as lit objects.
         =================================================================== -->
    <color name="felt_950">#FF06170F</color>  <!-- scrim, status bar, deepest well -->
    <color name="felt_900">#FF0A2318</color>  <!-- window background -->
    <color name="felt_850">#FF0B2A1C</color>  <!-- app bar -->
    <color name="felt_800">#FF0E2E20</color>  <!-- resting card surface -->
    <color name="felt_700">#FF143B29</color>  <!-- raised surface -->
    <color name="felt_600">#FF1B4A34</color>  <!-- pressed / highest surface -->
    <color name="felt_outline">#FF2A5B44</color>
    <!-- Boundary of an interactive control (outlined buttons, toggle segments,
         text field boxes). felt_outline is only 1.87:1 on felt_800 — fine for a
         decorative card edge, but it made the segmented control read as floating
         text rather than a control. 3.62:1 clears the 3:1 bar for UI components. -->
    <color name="control_outline">#FF4E8A6C</color>
    <color name="felt_outline_soft">#FF1E4732</color>

    <!-- ===================================================================
         Brass — the accent. Replaces the previous pure #FFD700 gold, which
         vibrated against saturated green and read as costume jewellery.
         =================================================================== -->
    <color name="brass_300">#FFF0CC74</color>  <!-- hover / light text on felt -->
    <color name="brass_400">#FFE3B341</color>  <!-- primary -->
    <color name="brass_600">#FFA87B2A</color>  <!-- stroke, pressed -->
    <color name="brass_900">#FF3A2C10</color>  <!-- primary container on felt -->

    <!-- ===================================================================
         Playing card face — warm bone rather than clinical white, with ink
         and ink-red for the printed suits.
         =================================================================== -->
    <color name="bone">#FFF4EFE4</color>
    <color name="bone_shade">#FFE4DCCB</color>
    <color name="ink">#FF171412</color>
    <color name="ink_muted">#FF5C554D</color>
    <color name="ink_red">#FFB3271E</color>

    <!-- ===================================================================
         Text on felt. These replace the old #B0FFFFFF / #80FFFFFF /
         #E0FFFFFF / #D0FFFFFF / #50FFFFFF family of near-duplicate alphas.
         =================================================================== -->
    <color name="text_primary">#FFF5F1E8</color>
    <color name="text_secondary">#FFB9C7BE</color>
    <color name="text_tertiary">#FF8A9C90</color>
    <!-- Disabled text was #5F6F65, which is only 2.34:1 on felt_700 — a disabled
         Create Match button was effectively unreadable, and that button starts
         disabled. Disabled state is signalled by the flat fill instead. -->
    <color name="text_disabled">#FF8A9C90</color>

    <!-- ===================================================================
         Semantic. Muted enough to live on felt without competing with brass.
         =================================================================== -->
    <color name="success">#FF4E9C6B</color>
    <color name="success_container">#FF12321F</color>
    <color name="warning">#FFD9A441</color>
    <color name="warning_container">#FF33280F</color>
    <color name="danger">#FFC4453C</color>
    <color name="danger_strong">#FF9E3229</color>
    <color name="danger_container">#FF3A1512</color>
    <!-- danger as *text on felt* — it is only 3.13:1 on felt_850, which passes
         for large type and nothing else. This lifts it to 4.73:1, so the
         scoreboard's trailing total is legible at any size. danger itself stays
         put: it is the fill and stroke colour of the loss banner, where it sits
         on danger_container instead. -->
    <color name="danger_bright">#FFE06B60</color>

    <!-- ===================================================================
         Fixed neutrals and translucent overlays. The overlays are named by
         intent, not by opacity, so their alpha can be tuned in one place.
         =================================================================== -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>

    <color name="overlay_scrim">#B306170F</color>       <!-- dialog / sheet scrim -->
    <color name="overlay_well">#33000000</color>        <!-- inset play area -->
    <color name="overlay_ripple_light">#26F5F1E8</color>
    <color name="overlay_ripple_brass">#33E3B341</color>
    <color name="overlay_divider">#332A5B44</color>

</resources>
