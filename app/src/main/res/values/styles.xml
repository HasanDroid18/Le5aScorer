<?xml version="1.0" encoding="utf-8"?>
<!--
  Component styles.

  Every repeated widget treatment lives here. Layouts reference a style rather
  than restating 15-20 attributes — the four identical TextInputLayout blocks in
  fragment_new_match.xml collapse to a single style reference each, and every
  card in the app now derives from one of three card styles.
-->
<resources>

    <!-- ===================================================================
         Shape
         =================================================================== -->
    <style name="ShapeAppearance.Le5a.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.Le5a.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.Le5a.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- ===================================================================
         Cards

         Hierarchy is carried by surface tone and elevation. Previously every
         card wore a 1-2dp gold stroke, which flattened the hierarchy — the
         stroke is now reserved for genuinely selected or emphasised surfaces.
         =================================================================== -->
    <style name="Widget.Le5a.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/felt_800</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/elev_card</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="strokeColor">@color/felt_outline_soft</item>
        <item name="rippleColor">@color/overlay_ripple_light</item>
    </style>

    <!-- A raised felt card, e.g. the round-status panel. -->
    <style name="Widget.Le5a.Card.Raised">
        <item name="cardBackgroundColor">@color/felt_700</item>
        <item name="strokeColor">@color/felt_outline</item>
    </style>

    <!-- A playing card lying face-up on the table. -->
    <style name="Widget.Le5a.Card.Playing">
        <item name="cardBackgroundColor">@color/bone</item>
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="cardElevation">@dimen/elev_float</item>
        <item name="strokeWidth">@dimen/stroke_none</item>
        <item name="rippleColor">@color/overlay_ripple_brass</item>
    </style>

    <style name="Widget.Le5a.Card.Playing.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Le5a.Card.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===================================================================
         Buttons

         Two rules, stated here rather than left to call sites:

         1. Vertical insets are zeroed. Material's default 6dp top/bottom inset
            meant a button with minHeight 56dp only drew ~44dp of pill, and a
            segment pinned to a 48dp height drew 36dp — which is what made the
            buttons look squashed and inconsistent from screen to screen.
         2. Shape is by role. Primary and Secondary are pills; Outlined,
            toggle segments and icon buttons are radius_md. Call sites must not
            override either, so the system stays legible.

         Height is a minHeight, never a fixed layout_height, so a button grows
         with large font settings instead of clipping its own label.
         =================================================================== -->
    <style name="Widget.Le5a.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">@dimen/stroke_none</item>
        <item name="android:insetBottom">@dimen/stroke_none</item>
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Label</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Le5a.Button.Primary">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="iconTint">@color/btn_primary_text</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">@dimen/elev_raised</item>
    </style>

    <!-- Quiet action on felt: tonal fill, no accent. -->
    <style name="Widget.Le5a.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">@dimen/stroke_none</item>
        <item name="android:insetBottom">@dimen/stroke_none</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Label</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="backgroundTint">@color/btn_secondary_bg</item>
        <item name="iconTint">@color/btn_secondary_text</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Segments of a MaterialButtonToggleGroup. No cornerRadius here: the group
         shapes the outer corners of the run, and a per-child radius fights it. -->
    <style name="Widget.Le5a.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">@dimen/stroke_none</item>
        <item name="android:insetBottom">@dimen/stroke_none</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Label</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="strokeColor">@color/toggle_stroke</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="iconTint">@color/toggle_text</item>
        <item name="iconSize">@dimen/icon_sm</item>
        <item name="iconPadding">@dimen/space_xs</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Le5a.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">@dimen/stroke_none</item>
        <item name="android:insetBottom">@dimen/stroke_none</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Label</item>
        <item name="android:textColor">@color/brass_300</item>
        <item name="iconTint">@color/brass_300</item>
        <item name="iconSize">@dimen/icon_sm</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="rippleColor">@color/overlay_ripple_brass</item>
    </style>

    <style name="Widget.Le5a.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:insetTop">@dimen/stroke_none</item>
        <item name="android:insetBottom">@dimen/stroke_none</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="rippleColor">@color/overlay_ripple_light</item>
    </style>

    <style name="Widget.Le5a.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brass_400</item>
        <item name="tint">@color/felt_950</item>
        <item name="elevation">@dimen/elev_float</item>
    </style>

    <!-- ===================================================================
         App bar and tabs
         =================================================================== -->
    <style name="Widget.Le5a.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Le5a.Title</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Le5a.Body.Small</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="android:elevation">@dimen/elev_flat</item>
    </style>

    <style name="Widget.Le5a.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextColor">@color/text_tertiary</item>
        <item name="tabSelectedTextColor">@color/brass_300</item>
        <item name="tabIndicatorColor">@color/brass_400</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabRippleColor">@color/overlay_ripple_brass</item>
        <item name="tabTextAppearance">@style/TextAppearance.Le5a.Label</item>
    </style>

    <!-- ===================================================================
         Text input
         =================================================================== -->
    <style name="Widget.Le5a.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/felt_900</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_selected</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/brass_300</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="startIconTint">@color/text_tertiary</item>
        <item name="endIconTint">@color/text_tertiary</item>
        <item name="placeholderTextColor">@color/text_disabled</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Le5a.TextInput</item>
    </style>

    <style name="ThemeOverlay.Le5a.TextInput" parent="">
        <item name="editTextStyle">@style/Widget.Le5a.TextInput.EditText</item>
        <item name="colorControlActivated">@color/brass_400</item>
    </style>

    <style name="Widget.Le5a.TextInput.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- ===================================================================
         Chips — the removable "who took what" tokens on the round screen.
         =================================================================== -->
    <style name="Widget.Le5a.Chip.Action" parent="Widget.Material3.Chip.Input">
        <item name="chipBackgroundColor">@color/felt_700</item>
        <item name="chipStrokeColor">@color/felt_outline</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Label.Small</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="closeIconTint">@color/text_tertiary</item>
        <item name="chipIconTint">@color/brass_300</item>
        <item name="rippleColor">@color/overlay_ripple_light</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- ===================================================================
         Progress
         =================================================================== -->
    <style name="Widget.Le5a.Progress.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/brass_400</item>
        <item name="trackColor">@color/felt_outline</item>
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <!-- ===================================================================
         Menus and dialogs — these are the surfaces that used to render as
         white boxes because the base theme was Material3 *Light*.
         =================================================================== -->
    <style name="Widget.Le5a.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/elev_float</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Le5a.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/felt_800</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainerHigh">@color/felt_800</item>
        <item name="colorPrimary">@color/brass_300</item>
        <item name="android:fontFamily">@font/le5a_sans</item>
        <item name="fontFamily">@font/le5a_sans</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Le5a.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Le5a.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Le5a.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Le5a.Button.Text</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Le5a.Large</item>
    </style>

    <style name="TextAppearance.Le5a.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Le5a.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===================================================================
         Text helpers used directly by layouts
         =================================================================== -->
    <style name="Widget.Le5a.SectionHeader" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Le5a.Overline</item>
    </style>

    <!-- A settings / list row: felt surface, hairline outline, brass ripple. -->
    <style name="Widget.Le5a.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

</resources>
