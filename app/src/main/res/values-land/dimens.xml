<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape on a narrow screen. Landscape is short, so anything sized for
  vertical room gives some back.

  Careful with the bucket names here: smallest-width outranks orientation, so a
  value set in values-sw360dp beats the same value set in values-land on every
  phone at least 360dp wide — which is all of them. Any dimen that this file and
  values-sw360dp both want to change therefore also needs an entry in
  values-sw360dp-land, or the landscape version silently never applies.
  icon_empty_state is only overridden here, so it needs no counterpart.
-->
<resources>
    <dimen name="icon_empty_state">56dp</dimen>
    <dimen name="heart_pip_height">32dp</dimen>
    <dimen name="assign_card_height">64dp</dimen>
</resources>
