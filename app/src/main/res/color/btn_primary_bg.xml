<?xml version="1.0" encoding="utf-8"?>
<!-- Disabled primary buttons drop to flat felt so "can't press this yet" is
     unmistakable. Previously a disabled Save kept its full brass styling. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/felt_700" />
    <item android:color="@color/brass_400" />
</selector>
